<Project Sdk="Microsoft.NET.Sdk">

  <!-- 影·筛 桌面程序（WPF）。可执行文件名就叫「影·筛.exe」。
       命令行模式：自检 selftest、基准测试 bench。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>影·筛</AssemblyName>
    <RootNamespace>YingShai.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\影筛.ico</ApplicationIcon>
    <StartupObject>YingShai.App.Program</StartupObject>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YingShai.Core\YingShai.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 程序图标：同时作为 exe 图标和应用内窗口图标（Resource 便于 XAML 引用） -->
    <Resource Include="Assets\影筛.ico" />
  </ItemGroup>

</Project>
