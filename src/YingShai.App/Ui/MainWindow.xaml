<Window x:Class="YingShai.App.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="clr-namespace:YingShai.Core.Model;assembly=YingShai.Core"
        Title="影·筛" Height="880" Width="1320" MinHeight="620" MinWidth="960"
        Background="#1B1B1F" Foreground="#E8E8E8"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing"
        Loaded="OnLoaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 颜色 -->
        <SolidColorBrush x:Key="PanelBrush" Color="#232329"/>
        <SolidColorBrush x:Key="BarBrush" Color="#2B2B33"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4FA8FF"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#33C57A"/>
        <SolidColorBrush x:Key="DimBrush" Color="#9A9AA6"/>
        <SolidColorBrush x:Key="SelBrush" Color="#3A3A46"/>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#33333D"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#44444F"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3D3D49"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,7,0,1"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- 缩略图条：虚拟化 + 回收，横向像素滚动（spike S4 的结论） -->
        <Style x:Key="ThumbItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" BorderThickness="2" BorderBrush="Transparent"
                                Width="168" Height="192" Margin="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E2E38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 工具栏 -->
            <RowDefinition Height="*"/>      <!-- 大图 + 右侧信息栏 -->
            <RowDefinition Height="Auto"/>   <!-- 横向缩略图条 -->
            <RowDefinition Height="Auto"/>   <!-- 状态栏 -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="270"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 工具栏 ============ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource BarBrush}" Padding="10,8">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Click="OnOpenFolder" Content="打开文件夹…" ToolTip="Ctrl+O"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Click="OnRefresh" Content="刷新" ToolTip="F5"/>
                <Rectangle DockPanel.Dock="Left" Width="1" Fill="#3A3A44" Margin="4,2,10,2"/>

                <TextBlock DockPanel.Dock="Left" Text="排序" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="SortCombo" DockPanel.Dock="Left" Width="118" Margin="0,0,6,0"
                          SelectionChanged="OnSortChanged" Background="#DDDDDD" Foreground="#111111" BorderBrush="#44444F">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="#EEEEEE"/>
                            <Setter Property="Background" Value="#2B2B33"/>
                            <Setter Property="Padding" Value="8,4"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBoxItem Content="文件名"/>
                    <ComboBoxItem Content="拍摄时间"/>
                    <ComboBoxItem Content="修改时间"/>
                    <ComboBoxItem Content="文件大小"/>
                </ComboBox>
                <Button DockPanel.Dock="Left" x:Name="SortDirButton" Style="{StaticResource ToolButton}" Click="OnToggleSortDir" Content="升序" ToolTip="切换升降序"/>

                <Rectangle DockPanel.Dock="Left" Width="1" Fill="#3A3A44" Margin="8,2,10,2"/>
                <CheckBox x:Name="MoveModeCheck" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#EDEDED"
                          Content="标记时移动（默认复制）" IsChecked="{Binding MarkByMove, Mode=TwoWay}" Margin="0,0,12,0"/>

                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="OnUndo" Content="{Binding UndoText}"
                        IsEnabled="{Binding CanUndo}" ToolTip="Ctrl+Z"/>
            </DockPanel>
        </Border>

        <!-- ============ 大图区 ============ -->
        <Grid Grid.Row="1" Grid.Column="0" x:Name="ImageArea" Background="#101014" ClipToBounds="True"
              MouseLeftButtonDown="OnImageMouseDown"
              MouseLeftButtonUp="OnImageMouseUp" MouseMove="OnImageMouseMove"
              LostMouseCapture="OnImageLostCapture"
              SizeChanged="OnImageAreaSizeChanged">
            <!-- 必须用 Canvas 承载大图：Grid 会给子元素施加布局裁剪，8191px 的图只有左上角一块能画出来 -->
            <Canvas x:Name="ImageHost" ClipToBounds="False">
                <Image x:Name="MainImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0,0"
                       Source="{Binding LargeImage}">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ImgScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="ImgTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Canvas>

            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#6A6A78" FontSize="15" TextAlignment="Center"
                       Text="把文件夹拖进来，或点左上角「打开文件夹」&#10;（← → 切图，X / Enter 标记，Ctrl+Z 撤销）"/>
            <TextBlock x:Name="LoadingHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#9CC7FF" FontSize="14" Visibility="Collapsed" Text="正在解码…"/>

            <!-- 缩放控制条 -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14"
                    Background="#CC1B1B1F" CornerRadius="6" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="适应" Click="OnZoomFit" ToolTip="双击大图同样效果"/>
                    <Button Style="{StaticResource ToolButton}" Content="100%" Click="OnZoomActual" ToolTip="按原始像素显示（后台全解）"/>
                    <TextBlock x:Name="ZoomLabel" Text="{Binding ZoomText}" Foreground="{StaticResource DimBrush}"
                               VerticalAlignment="Center" MinWidth="76" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 右侧信息栏 ============ -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBrush}" Padding="14,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="信息" FontSize="13" FontWeight="SemiBold" Foreground="#CFCFDA" Margin="0,0,0,6"/>

                    <TextBlock Text="文件名" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Text="{Binding Current.Name}" Style="{StaticResource InfoValue}" TextWrapping="Wrap" MaxHeight="52"/>

                    <TextBlock Text="机型" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Text="{Binding CurrentInfo.DisplayModel}" Style="{StaticResource InfoValue}"/>

                    <TextBlock Text="镜头" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Text="{Binding CurrentInfo.DisplayLens}" Style="{StaticResource InfoValue}" TextWrapping="Wrap"/>

                    <TextBlock Text="焦距" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Text="{Binding CurrentInfo.DisplayFocal}" Style="{StaticResource InfoValue}"/>

                    <TextBlock Text="光圈" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Text="{Binding CurrentInfo.DisplayAperture}" Style="{StaticResource InfoValue}"/>

                    <TextBlock Text="快门" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Text="{Binding CurrentInfo.DisplayShutter}" Style="{StaticResource InfoValue}"/>

                    <TextBlock Text="ISO" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Text="{Binding CurrentInfo.DisplayIso}" Style="{StaticResource InfoValue}"/>

                    <TextBlock Text="拍摄时间" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Text="{Binding CurrentInfo.DisplayTakenAt}" Style="{StaticResource InfoValue}"/>

                    <TextBlock Text="分辨率" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Text="{Binding CurrentInfo.DisplayResolution}" Style="{StaticResource InfoValue}"/>

                    <TextBlock Text="文件大小" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource InfoValue}"/>

                    <TextBlock Text="色彩空间" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Text="{Binding CurrentInfo.DisplayColorSpace}" Style="{StaticResource InfoValue}"/>

                    <TextBlock Text="状态" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Text="{Binding Current.StatusText}" Style="{StaticResource InfoValue}" Foreground="#FFB86B" TextWrapping="Wrap"/>

                    <Border Height="1" Background="#3A3A44" Margin="0,12,0,8"/>
                    <TextBlock Text="{Binding FilePathText}" Foreground="#6F6F7C" FontSize="10.5" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ 横向缩略图条 ============ -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#17171B" BorderBrush="#33333C" BorderThickness="0,1,0,0">
            <ListBox x:Name="ThumbList" Height="200" Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding Items}" SelectedItem="{Binding Current, Mode=TwoWay}"
                     SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     ItemContainerStyle="{StaticResource ThumbItem}"
                     SelectionChanged="OnThumbSelectionChanged"
                     PreviewMouseLeftButtonDown="OnThumbPreviewMouseDown"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.CacheLength="2"
                     MouseDoubleClick="OnThumbDoubleClick"
                     PreviewMouseWheel="OnThumbWheel">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal"
                                                VirtualizingPanel.IsVirtualizing="True"
                                                VirtualizingPanel.VirtualizationMode="Recycling"
                                                VirtualizingPanel.ScrollUnit="Pixel"
                                                VirtualizingPanel.CacheLength="2"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type model:ImageItem}">
                        <Grid Width="164" Height="188">
                            <Border Background="#101014" CornerRadius="3" Margin="6,6,6,26">
                                <Image Source="{Binding Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                            </Border>
                            <TextBlock Text="{Binding Name}" Foreground="#B9B9C6" FontSize="10.5" Margin="8,0,8,20"
                                       VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="#FF9B5A" FontSize="9.5" Margin="8,0,8,6"
                                       VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>

                            <!-- 已标记：右上角绿色对勾角标 -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                    Width="24" Height="24" CornerRadius="12" Background="{StaticResource GreenBrush}"
                                    Visibility="{Binding IsMarked, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="✓" Foreground="White" FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- 处理中：转圈提示 -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                    Width="24" Height="24" CornerRadius="12" Background="#CC4444DD"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="…" Foreground="White" FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="移入筛选（X / Enter）" Click="OnMenuMark"/>
                                    <MenuItem Header="取消筛选" Click="OnMenuUnmark"/>
                                    <Separator/>
                                    <MenuItem Header="在资源管理器中显示" Click="OnMenuReveal"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{StaticResource BarBrush}" Padding="12,5">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding RemainingText}" Foreground="#FFD479" Margin="12,0,0,0"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Foreground="#9CC7FF" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource DimBrush}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
