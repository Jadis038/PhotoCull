<Project Sdk="Microsoft.NET.Sdk">

  <!-- 影·筛 S4 spike：横向虚拟化缩略图列表性能验证。
       纯 WPF 代码（无 XAML 文件、无第三方包），net8.0-windows。
       输出为控制台可执行程序，便于 run.ps1 一条命令采集表格。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>VirtList</AssemblyName>
    <RootNamespace>VirtList</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <StartupObject>VirtList.Program</StartupObject>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- 允许在无交互桌面的会话里跑（本机就是），并允许中文输出 -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

</Project>
