<?xml version="1.0" encoding="utf-8"?>
<!-- 与仓库根目录 NuGet.config 一致：国内镜像优先，nuget.org 兜底。
     spike 目录自带一份，保证脱离父目录复制出去也能 restore。 -->
<configuration>
  <packageSources>
    <clear />
    <add key="azure-cn" value="https://nuget.azure.cn/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
